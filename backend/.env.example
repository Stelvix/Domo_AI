PORT=3001
DATABASE_URL="file:./dev.db"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Adresse IP LAN de la machine hôte (utilisée par le QR code d'installation PWA).
# À renseigner uniquement si l'API est conteneurisée : les interfaces du
# conteneur ne sont pas joignables depuis un smartphone.
# HOST_LAN_IP="192.168.1.20"

# Delai maximal d'une generation LLM (chargement du modele inclus)
# OLLAMA_TIMEOUT_MS=600000
# Intervalle des keep-alive SSE
# SSE_HEARTBEAT_INTERVAL_MS=15000
# Nombre de messages d'historique reinjectes dans le contexte LLM
# CHAT_HISTORY_LIMIT=20
# Colonnes de la grille pixel art du bureau
# OFFICE_GRID_COLUMNS=4
