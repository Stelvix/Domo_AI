# Configuration npm pour fiabiliser les installations en CI et dans Docker.
#
# Les échecs "network read ECONNRESET" sur le registre npm sont fréquents sur
# les runners GitHub Actions et provoquent des builds de production aléatoires.
# On augmente donc le nombre de tentatives et les délais de back-off.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# Audit et funding : inutile et source de latence supplémentaire
audit=false
fund=false

# Journalisation plus verbeuse en cas d'échec d'installation
loglevel=warn
